# certificate.sympy -- IMR-AN-003
# CAS-checkable certificate for the certified transforms and the anti-equivalence.
from sympy import *

# CERT:T1
n=symbols('n',positive=True,integer=True); assert summation(1/n**2,(n,1,oo))==pi**2/6  # zeta(2)

# CERT:T2
n=symbols('n',positive=True,integer=True); assert summation(1/n**2,(n,1,oo)).is_finite  # absolutely convergent: rearrangement-invariant

# CERT:neg
n=symbols('n',positive=True,integer=True); assert summation((-1)**(n+1)/n,(n,1,oo))==log(2)  # alternating harmonic: CONDITIONALLY convergent (rearrangement-dependent)
